# ── Virtual environments ──
venv/
.venv/
env/

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# ── Secrets & credentials ──
.env
.env.*
*.pem
*.key
*.cert
*.crt
secrets/
credentials/
service-account*.json
*_secret*.json
*.credential

# ── API keys / tokens ──
**/api_key*
**/token*
*.token

# ── Slack / webhook configs ──
webhook_url*

